=====================================================================
ไฟล์ตัวอย่าง environment — คัดลอกเป็น .env แล้วแก้ค่าตามต้องการ
copy .env.example .env      (Windows)
cp .env.example .env        (macOS / Linux)
=====================================================================
---------- แอปพลิเคชัน ----------
PORT=3000
APP_URL=http://localhost:3000/

---------- PostgreSQL ----------
POSTGRES_USER=movie_user
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=movie_booking
POSTGRES_PORT=5432
DATABASE_URL=postgresql://movie_user:change-this-password@localhost:5432/movie_booking

---------- ความปลอดภัย (อย่างน้อย 32 ตัวอักษร — เปลี่ยนก่อนใช้งานจริง) ----------
SESSION_SECRET=change-this-secret-min-32-characters-long

---------- SMTP / Mailpit ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=MovieTicket-NoReply@movieticket.local
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

---------- ข้อมูลผู้ใช้ตั้งต้น (seed) ----------
SEED_ADMIN_EMAIL=admin@movieticket.local
SEED_ADMIN_PASSWORD=Admin@1234
SEED_USER_EMAIL=user@movieticket.local
SEED_USER_PASSWORD=User@1234
